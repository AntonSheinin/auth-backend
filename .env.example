# Database Configuration (PostgreSQL only)
DATABASE_URL=postgresql://auth_user:auth_password@db:5432/auth_backend

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Auth Settings
AUTH_DURATION=180
SESSION_CLEANUP_INTERVAL=60

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_ACCESS_LOGS=true
LOG_RETENTION_DAYS=3
LOG_CLEANUP_INTERVAL=3600

# API Settings
API_HOST=0.0.0.0
API_PORT=8090

# Security (optional)
# API_KEY=your-secret-api-key
