# Database Configuration
# SQLite: sqlite:///./data/tokens.db (default - will be auto-converted to sqlite+aiosqlite://)
# PostgreSQL: postgresql://user:password@localhost/dbname (will be auto-converted to postgresql+asyncpg://)
# MySQL: mysql://user:password@localhost/dbname
# Note: The application uses async drivers. Sync URLs are automatically converted.
DATABASE_URL=sqlite:///./data/tokens.db

# Database Connection Pool Settings (PostgreSQL/MySQL only, ignored for SQLite)
# DB_POOL_SIZE: Number of connections to keep in the pool (1-50, default: 5)
DB_POOL_SIZE=5

# DB_MAX_OVERFLOW: Maximum number of connections beyond pool_size (0-100, default: 10)
DB_MAX_OVERFLOW=10

# DB_POOL_TIMEOUT: Seconds to wait for a connection from pool (5-300, default: 30)
DB_POOL_TIMEOUT=30

# Auth Settings
# AUTH_DURATION: Default session duration in seconds (30-3600, default: 180 = 3 minutes)
AUTH_DURATION=180

# SESSION_CLEANUP_INTERVAL: How often to cleanup expired sessions in seconds (10-600, default: 60)
SESSION_CLEANUP_INTERVAL=60

# Logging Configuration
# LOG_LEVEL: DEBUG, INFO (default), WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ENABLE_ACCESS_LOGS: Whether to log all authorization attempts to database (default: true)
ENABLE_ACCESS_LOGS=true

# API Settings
# API_HOST: IP address to bind server to (default: 0.0.0.0 = all interfaces)
API_HOST=0.0.0.0

# API_PORT: Port to listen on (1024-65535, default: 8080)
API_PORT=8080

# Security
# API_KEY: Optional API key for management endpoints (/api/tokens, /api/sessions)
# Leave empty to disable authentication for management endpoints
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
